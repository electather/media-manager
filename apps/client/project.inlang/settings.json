{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "en",
  "locales": ["en", "fa"],
  "modules": ["https://cdn.jsdelivr.net/npm/@inlang/plugin-message-format@latest/dist/index.js"],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/command/{locale}.json",
      "./messages/diagnostics/{locale}.json",
      "./messages/errors/{locale}.json",
      "./messages/home/{locale}.json",
      "./messages/library/{locale}.json",
      "./messages/notifications/{locale}.json"
    ]
  }
}
