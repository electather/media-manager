    {
      "declarations": ["input title"],
      "selectors": [],
      "match": {
        "*": "{title} قبلی"
      }
    }
  ],
  "media_row_next_aria": [
    {
      "declarations": ["input title"],
      "selectors": [],
      "match": {
        "*": "{title} بعدی"
      }
    }
  ]
}
