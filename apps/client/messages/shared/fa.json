{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "shared_password_error": [
    {
      "selectors": ["reason"],
      "match": {
        "reason=too_long": "گذرواژه باید حداکثر ۲۵۶ نویسه باشد.",
        "reason=missing_alphanumeric": "گذرواژه باید حداقل یک حرف و یک عدد داشته باشد.",
        "reason=too_short": "گذرواژه باید حداقل ۸ نویسه باشد.",
        "reason=*": "گذرواژه نامعتبر است."
      }
    }
  ],
  "shared_time_missing": "—",
  "shared_time_never": "هرگز",
  "shared_time_just_now": "همین حالا",
  "shared_time_relative_long": [
    {
      "declarations": [
        "input duration",
        "input unit",
        "local formattedDuration = duration: relativetime unit=$unit numeric=auto"
      ],
      "match": {
        "duration=*, unit=*": "{formattedDuration}"
      }
    }
  ],
  "shared_time_relative_narrow": [
    {
      "declarations": [
        "input duration",
        "input unit",
        "local formattedDuration = duration: relativetime unit=$unit numeric=auto style=narrow"
      ],
      "match": {
        "duration=*, unit=*": "{formattedDuration}"
      }
    }
  ],
  "shared_time_short_date": [
    {
      "declarations": [
        "input date",
        "local formattedDate = date: datetime month=short day=numeric"
      ],
      "match": {
        "date=*": "{formattedDate}"
      }
    }
  ],
  "shared_time_absolute": [
    {
      "declarations": [
        "input date",
        "local formattedDate = date: datetime month=short day=numeric hour=2-digit minute=2-digit second=2-digit"
      ],
      "match": {
        "date=*": "{formattedDate}"
      }
    }
  ],
  "shared_time_duration": [
    {
      "declarations": [
        "input unit",
        "input value",
        "input secondaryValue",
        "local formattedValue = value: number maximumFractionDigits=2",
        "local formattedSecondaryValue = secondaryValue: number maximumFractionDigits=0"
      ],
      "selectors": ["unit"],
      "match": {
        "unit=sub_ms": "<۱ ms",
        "unit=ms": "{formattedValue} ms",
        "unit=s": "{formattedValue} s",
        "unit=min_s": "{formattedValue}m {formattedSecondaryValue}s"
      }
    }
  ],
  "shared_pagination_error_message": "TODO",
  "shared_pagination_error_body": "TODO",
  "shared_pagination_retry": "TODO",
  "shared_pagination_loading": "TODO"
}
