  "auth_invite_submit": [
    {
      "selectors": ["status"],
      "match": {
        "status=pending": "Creating account…",
        "status=*": "Create account"
      }
    }
  ],
  "auth_login_submit": [
    {
      "selectors": ["status"],
      "match": {
        "status=pending": "Logging in…",
        "status=*": "Sign in"
      }
    }
  ],
  "auth_register_submit": [
    {
      "selectors": ["status"],
      "match": {
        "status=pending": "Creating account…",
        "status=*": "Create account"
      }
    }
  ],
  "auth_reset_submit": [
    {
      "selectors": ["status"],
      "match": {
        "status=pending": "Sending…",
        "status=*": "Send reset link"
      }
    }
  ]
