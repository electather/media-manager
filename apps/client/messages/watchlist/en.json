{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "watchlist_eyebrow": "Your watchlist · curated",
  "watchlist_title": "Watchlist",
  "watchlist_total_runtime": "{value} of stories",
  "watchlist_runtime_days_hours": "{days}d {hours}h",
  "watchlist_runtime_hours": "{hours}h",
  "watchlist_runtime_hours_minutes": "{hours}h {minutes}m",
  "watchlist_runtime_minutes": "{minutes}m",
  "watchlist_count": [
    {
      "declarations": ["input bucket", "input n"],
      "selectors": ["bucket"],
      "match": {
        "bucket=ready": "{n} ready",
        "bucket=awaiting": "{n} awaiting",
        "bucket=upcoming": "{n} upcoming"
      }
    }
  ],
  "watchlist_filter_label": "Filter watchlist",
  "watchlist_filter": [
    {
      "declarations": ["input bucket"],
      "selectors": ["bucket"],
      "match": {
        "bucket=all": "All",
        "bucket=ready": "Ready",
        "bucket=in-progress": "In progress",
        "bucket=awaiting": "Awaiting",
        "bucket=unavailable": "Unavailable",
        "bucket=upcoming": "Upcoming"
      }
    }
  ],
  "watchlist_sort_label": "Sort",
  "watchlist_sort": [
    {
      "declarations": ["input sortKey"],
      "selectors": ["sortKey"],
      "match": {
        "sortKey=recent": "Recently added",
        "sortKey=alpha": "A → Z",
        "sortKey=runtime": "Shortest first",
        "sortKey=status": "By status"
      }
    }
  ],
  "watchlist_filtered_eyebrow": "{filter} · sorted {sort}",
  "watchlist_filtered_title": "Filtered view",
  "watchlist_section_eyebrow": [
    {
      "declarations": ["input section"],
      "selectors": ["section"],
      "match": {
        "section=tonight": "One step further than 'Recommended'",
        "section=ready": "No request needed · stream tonight",
        "section=mood": "Grouped by feel, not genre",
        "section=coming_up": "Drops, premieres, return dates",
        "section=awaiting": "Saved, but not on your servers yet",
        "section=recent": "Audit trail"
      }
    }
  ],
  "watchlist_section_title": [
    {
      "declarations": ["input section"],
      "selectors": ["section"],
      "match": {
        "section=tonight": "Tonight",
        "section=ready": "Ready to watch",
        "section=mood": "By mood",
        "section=coming_up": "Coming up",
        "section=awaiting": "Awaiting",
        "section=recent": "Recently added"
      }
    }
  ],
  "watchlist_tonight_caption": "Picked from your watchlist · 9:42 PM",
  "watchlist_tonight_alternates_kicker": "Or maybe…",
  "watchlist_ready_scroll_prev": "Scroll left",
  "watchlist_ready_scroll_next": "Scroll right",
  "watchlist_mood_cluster_eyebrow": "Mood",
  "watchlist_mood_auto_clustered": "auto-clustered · {count} moods",
  "watchlist_mood_see_all": "See all {n}",
  "watchlist_mood_label": [
    {
      "declarations": ["input moodId"],
      "selectors": ["moodId"],
      "match": {
        "moodId=slow_burn": "Slow burn",
        "moodId=quiet_thrill": "Quiet thrillers",
        "moodId=period": "Period drama",
        "moodId=scifi": "Hard sci-fi",
        "moodId=comedy": "Easy laughs",
        "moodId=horror": "Atmospheric horror",
        "moodId=cozy": "Cozy night in",
        "moodId=epic": "Epic",
        "moodId=cerebral": "Cerebral",
        "moodId=dark": "Dark",
        "moodId=laugh": "Laugh out loud",
        "moodId=throwback": "Throwback",
        "moodId=quick": "Quick watch",
        "moodId=binge": "Binge-worthy"
      }
    }
  ],
  "watchlist_mood_note": [
    {
      "declarations": ["input moodId"],
      "selectors": ["moodId"],
      "match": {
        "moodId=slow_burn": "Long takes, careful framing.",
        "moodId=quiet_thrill": "Procedural, restrained.",
        "moodId=period": "Costumes, candles, courtrooms.",
        "moodId=scifi": "Stars, signals, silence.",
        "moodId=comedy": "Ensemble, breezy.",
        "moodId=horror": "Dread without splatter.",
        "moodId=cozy": "Light, warm, easy to sink into.",
        "moodId=epic": "Big runtime, bigger stakes.",
        "moodId=cerebral": "Slow burn, meditative.",
        "moodId=dark": "Thriller, horror, crime.",
        "moodId=laugh": "Comedy, animation, easy laughs.",
        "moodId=throwback": "Pre-1990 classics.",
        "moodId=quick": "Movies under 95 minutes.",
        "moodId=binge": "TV ready to marathon."
      }
    }
  ],
  "watchlist_view_all_items": "View all items",
  "watchlist_all_page_title": "All watchlist items",
  "watchlist_all_page_eyebrow": "Filter and sort the full set",
  "watchlist_mood_page_title": "{mood}",
  "watchlist_mood_page_eyebrow": "{count} items in this mood",
  "watchlist_mood_back": "All moods",
  "watchlist_breadcrumb_label": "Breadcrumb",
  "watchlist_breadcrumb_root": "Watchlist",
  "watchlist_breadcrumb_moods": "Moods",
  "watchlist_mood_count": "{count} titles",
  "watchlist_awaiting_request_all": "Request all missing",
  "watchlist_recent_source": [
    {
      "declarations": ["input source"],
      "selectors": ["source"],
      "match": {
        "source=recommended": "Recommended for you",
        "source=notification": "From notification",
        "source=search": "Search",
        "source=trending": "Trending",
        "source=friend": "Friend's list"
      }
    }
  ],
  "watchlist_recent_time": [
    {
      "declarations": ["input unit", "input n"],
      "selectors": ["unit"],
      "match": {
        "unit=just_now": "Just now",
        "unit=minutes_ago": "{n} min ago",
        "unit=hours_ago": "{n} hours ago",
        "unit=yesterday": "Yesterday",
        "unit=days_ago": "{n} days ago",
        "unit=last_week": "Last week"
      }
    }
  ],
  "watchlist_kind": [
    {
      "declarations": ["input kind"],
      "selectors": ["kind"],
      "match": {
        "kind=movie": "Movie",
        "kind=tv": "TV series",
        "kind=*": "TV series"
      }
    }
  ],
  "watchlist_episodes_count": "{n} eps",
  "watchlist_section_count_aria": "{count} items",
  "watchlist_partial_banner": "Some watchlist items couldn't be loaded. Refresh to try again.",
  "watchlist_empty_title": [
    {
      "declarations": ["input bucket"],
      "selectors": ["bucket"],
      "match": {
        "bucket=ready": "Nothing ready",
        "bucket=in-progress": "No active sessions",
        "bucket=awaiting": "No items awaiting",
        "bucket=unavailable": "Nothing to acquire",
        "bucket=upcoming": "Nothing upcoming"
      }
    }
  ],
  "watchlist_empty_description": [
    {
      "declarations": ["input bucket"],
      "selectors": ["bucket"],
      "match": {
        "bucket=ready": "Items appear here once they land on a connected media server.",
        "bucket=in-progress": "Resume something you've started watching to fill this section.",
        "bucket=awaiting": "Items show here once you request them via a connected request app, like Overseerr.",
        "bucket=unavailable": "Items wishlisted that aren't on a media server and haven't been requested yet.",
        "bucket=upcoming": "Future releases on your watchlist show up here."
      }
    }
  ],
  "watchlist_empty_mood_title": "{moodLabel} is empty",
  "watchlist_empty_mood_description": "No items match this mood yet.",
  "watchlist_add_error": "Couldn't add to watchlist. {message}",
  "watchlist_remove_error": "Couldn't remove from watchlist. {message}",
  "watchlist_toggle_add": "Add to watchlist",
  "watchlist_toggle_remove": "Remove from watchlist",
  "watchlist_load_error_title": "Watchlist couldn't load",
  "watchlist_load_error_retry": "Retry",
  "watchlist_load_more": "Load more",
  "watchlist_loading_more": "Loading…",
  "watchlist_source": [
    {
      "declarations": ["input source"],
      "selectors": ["source"],
      "match": {
        "source=manual": "Added manually",
        "source=plugin": "Synced from plugin",
        "source=search": "From search",
        "source=notification": "From notification",
        "source=recommended": "Recommended",
        "source=trending": "Trending"
      }
    }
  ]
}
