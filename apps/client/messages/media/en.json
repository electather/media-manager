{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "media_details_close": "Close",
  "media_details_close_trailer": "Close trailer",
  "media_details_kind_movie": "Movie",
  "media_details_kind_tv": "TV Series",
  "media_details_rating_label": "Your rating",
  "media_details_vote_like": "Like",
  "media_details_vote_dislike": "Dislike",
  "media_details_note_label": "Your note",
  "media_details_note_add": "Note",
  "media_details_note_added": "Note added",
  "media_details_note_save": "Save note",
  "media_details_note_cancel": "Cancel",
  "media_details_note_edit": "Edit",
  "media_details_note_placeholder": "Add a private note — why you saved it, who recommended it, what to remember…",
  "media_details_note_sentiment": "Analyzed for sentiment",
  "media_details_note_saved_toast": "Note saved",
  "media_details_note_removed_toast": "Note removed",
  "media_details_note_aria_add": "Add a note",
  "media_details_note_aria_edit": "Edit your note",
  "media_details_tunes_recs": "tunes your recommendations",
  "media_details_director": "Director",
  "media_details_starring": "Starring",
  "media_details_series": "Series",
  "media_details_series_ongoing": "Ongoing",
  "media_details_series_finished": "Finished",
  "media_details_next_air_date": "Next air date",
  "media_details_rating": "Rating",
  "media_details_audience": "Audience",
  "media_details_critics": "Critics",
  "media_details_seasons_title": "Seasons & Episodes",
  "media_details_seasons_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} season",
        "countPlural=other": "{count} seasons"
      }
    }
  ],
  "media_details_status_available": "Available",
  "media_details_status_requested": "Requested",
  "media_details_status_unavailable": "Unavailable",
  "media_details_status_partial": "Partial",
  "media_details_status_upcoming": "Upcoming",
  "media_details_action_trailer": "Trailer",
  "media_details_action_watchlist": "Watchlist",
  "media_details_action_watchlist_on": "On watchlist",
  "media_details_action_watched": "Mark watched",
  "media_details_action_watched_on": "Watched",
  "media_details_more_options": "More options",
  "media_details_why_this": "Why this →",
  "media_details_cancel_request": "Cancel request",
  "media_details_opening_stream": "Opening stream…",
  "media_details_episodes_upcoming": "{count} episodes upcoming",
  "media_details_episodes_partial": "{available} of {total} available",
  "media_details_episodes_total": "{total} episodes",
  "media_details_trailer_caption": "[ trailer · {title} ]",
  "media_card_kind_movie": "Movie",
  "media_card_kind_tv": "TV series",
  "media_card_status_available": "Available",
  "media_card_status_requested": "Requested",
  "media_card_status_processing": "Processing",
  "media_card_status_unavailable": "Unavailable",
  "media_card_status_unknown": "Unknown",
  "media_card_watchlist_add": "Add to watchlist",
  "media_card_watchlist_remove": "Remove from watchlist",
  "media_card_min_left_short": [
    {
      "declarations": ["input minutes"],
      "selectors": [],
      "match": {
        "*": "{minutes}min left"
      }
    }
  ],
  "media_card_hour_min_left": [
    {
      "declarations": ["input hours", "input minutes"],
      "selectors": [],
      "match": {
        "*": "{hours}h {minutes}min left"
      }
    }
  ],
  "media_card_watched_count": [
    {
      "declarations": ["input watched", "input total"],
      "selectors": [],
      "match": {
        "*": "{watched}/{total} watched"
      }
    }
  ],
  "media_card_aria_label": [
    {
      "declarations": ["input title", "input year"],
      "selectors": [],
      "match": {
        "*": "{title}, {year}"
      }
    }
  ],
  "media_row_partial_tooltip": "Some sources didn't respond — showing what we could fetch.",
  "media_row_prev_aria": [
    {
      "declarations": ["input title"],
      "selectors": [],
      "match": {
        "*": "Previous {title}"
      }
    }
  ],
  "media_row_next_aria": [
    {
      "declarations": ["input title"],
      "selectors": [],
      "match": {
        "*": "Next {title}"
      }
    }
  ]
}
