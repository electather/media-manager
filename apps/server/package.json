{
  "name": "@nama/server",
  "version": "0.7.0",
  "private": false,
  "description": "MCP server and API backend for nama — self-hosted entertainment management with Hono, Better Auth, and a plugin system.",
  "keywords": [
    "bun",
    "entertainment",
    "hono",
    "mcp",
    "media-server",
    "self-hosted"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    "./api/router": "./src/api/router.ts",
    "./auth": "./src/auth/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env.dev x drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env.dev src/db/migrate.ts",
    "test": "vp test"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "catalog:",
    "@hono/zod-validator": "^0.8.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@libsql/client": "^0.17.2",
    "@nama/plugin-discord": "workspace:*",
    "@nama/plugin-fanart": "workspace:*",
    "@nama/plugin-inbox": "workspace:*",
    "@nama/plugin-jellyfin": "workspace:*",
    "@nama/plugin-ntfy": "workspace:*",
    "@nama/plugin-plex": "workspace:*",
    "@nama/plugin-sdk": "workspace:*",
    "@nama/plugin-seerr": "workspace:*",
    "@nama/plugin-telegram": "workspace:*",
    "@nama/plugin-tmdb": "workspace:*",
    "@nama/plugin-trakt": "workspace:*",
    "@nama/plugin-tvdb": "workspace:*",
    "@nama/shared": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "ajv": "^8.18.0",
    "better-auth": "catalog:",
    "consola": "^3.4.2",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "es-toolkit": "catalog:",
    "hono": "catalog:",
    "ioredis": "^5.10.1",
    "jszip": "catalog:",
    "lru-cache": "^11.3.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
