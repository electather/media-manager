# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local SQLite database path (libSQL `file:` URL). For Docker Compose,
# `file:/data/nama.db` maps to the mounted `/data` volume.
# Default when unset: `file:./data/nama.db`.
SQLITE_PATH=file:./data/nama.db

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# Cache provider: "memory" or "redis".
CACHE_PROVIDER=memory

# Redis connection URL. Required only when CACHE_PROVIDER=redis.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# Public-facing URL of this deployment (used by plugins for OAuth redirect
# URIs, playerLink / webLink, etc.). Must be a valid http(s) URL — startup
# fails if missing or malformed. Trailing slashes are stripped.
APP_EXTERNAL_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Secret used to sign Better Auth sessions. Use a long random string.
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# Base URL Better Auth runs at.
BETTER_AUTH_URL=http://localhost:3000

# Optional comma-separated list of extra trusted origins for Better Auth.
BETTER_AUTH_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Credential encryption
# ---------------------------------------------------------------------------
# 256-bit key (hex) used to encrypt stored plugin credentials. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=generate-a-256-bit-hex-key

# ---------------------------------------------------------------------------
# Email & notifications
# ---------------------------------------------------------------------------
# Set true when a transactional-email provider is wired up; enables the
# Better Auth verification / reset-password / change-email mail hooks.
EMAIL_PROVIDER_CONFIGURED=false

# Master switch for the notifications subsystem. Defaults to true.
NOTIFICATIONS_ENABLED=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Max consola verbosity printed to stdout inside job runs. One of:
# silent | fatal | error | warn | log | info | debug | trace | verbose.
# Defaults to warn.
JOB_CONSOLE_LOG_LEVEL=warn

# ---------------------------------------------------------------------------
# Manual user creation (optional)
# ---------------------------------------------------------------------------
# Consumed only by `bun run db:create-user`. Leave unset for normal runs;
# in development a default admin (admin@me.com / password123) is seeded
# automatically by the migration step.
# CREATE_USER_EMAIL=
# CREATE_USER_PASSWORD=
# CREATE_USER_ROLE_ID=role_admin
# CREATE_USER_NAME=
