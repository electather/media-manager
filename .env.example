# SQLite database path. Accepts either a local `file:` URL for self-hosted
# deployments, or a hosted libSQL (Turso) URL (`libsql://…`) for Cloudflare
# Workers. For Docker Compose, `file:/data/ent-mcp.db` maps to the mounted
# `/data` volume. Default when unset: `file:./data/ent-mcp.db`.
SQLITE_PATH=file:./data/ent-mcp.db

# Turso auth token. Required only when SQLITE_PATH points at a hosted
# libSQL URL. Leave empty for local SQLite files.
LIBSQL_AUTH_TOKEN=

# Cache: "memory" or "redis"
CACHE_PROVIDER=memory

# Redis (only if CACHE_PROVIDER=redis)
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
HOST=0.0.0.0

# Public-facing URL of this deployment (used by plugins for OAuth redirect
# URIs, playerLink / webLink, etc.). Must be a valid URL — startup fails if
# missing or malformed.
APP_EXTERNAL_URL=http://localhost:3000

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Credential encryption
ENCRYPTION_KEY=generate-a-256-bit-hex-key

# Trakt
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Seerr
SEERR_URL=
SEERR_API_KEY=
