# Database: "postgres" or "sqlite"
DB_PROVIDER=sqlite

# PostgreSQL (only if DB_PROVIDER=postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/ent_mcp

# SQLite (only if DB_PROVIDER=sqlite)
SQLITE_PATH=./data/ent-mcp.db

# Cache: "memory" or "redis"
CACHE_PROVIDER=memory

# Redis (only if CACHE_PROVIDER=redis)
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
HOST=0.0.0.0

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Credential encryption
ENCRYPTION_KEY=generate-a-256-bit-hex-key

# Trakt
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# TMDB
TMDB_API_KEY=

# Seerr
SEERR_URL=
SEERR_API_KEY=

# TVDB
TVDB_API_KEY=
