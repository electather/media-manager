{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreDependencies": [
    "react-doctor",
    "@ent-mcp/plugin-discord",
    "@ent-mcp/plugin-inbox",
    "@ent-mcp/plugin-jellyfin",
    "@ent-mcp/plugin-ntfy",
    "@ent-mcp/plugin-plex",
    "@ent-mcp/plugin-seerr",
    "@ent-mcp/plugin-telegram",
    "@ent-mcp/plugin-tmdb",
    "@ent-mcp/plugin-trakt",
    "@ent-mcp/plugin-tvdb"
  ],
  "publicPackages": [
    "@ent-mcp/client",
    "@ent-mcp/server",
    "@ent-mcp/plugin-sdk",
    "@ent-mcp/plugin-trakt",
    "@ent-mcp/plugin-tmdb",
    "@ent-mcp/plugin-tvdb",
    "@ent-mcp/plugin-seerr",
    "@ent-mcp/plugin-plex",
    "@ent-mcp/plugin-jellyfin",
    "@ent-mcp/plugin-discord",
    "@ent-mcp/plugin-inbox",
    "@ent-mcp/plugin-ntfy",
    "@ent-mcp/plugin-telegram"
  ],
  "entry": ["apps/server/src/worker.ts"],
  "ignorePatterns": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.gen.ts",
    "**/dist/**",
    "**/node_modules/**",
    "**/.claude/**",
    "**/plan/**",
    "**/docs/**",
    "**/docker/**",
    "packages/plugins/**"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "warn",
    "unused-deps": "warn",
    "circular-deps": "warn"
  },
  "duplicates": {
    "mode": "semantic",
    "minTokens": 50,
    "minLines": 5,
    "ignoreImports": true,
    "ignore": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/*.tsx",
      "**/plugin.ts",
      "packages/plugins/**",
      "apps/server/src/db/schema/**",
      "apps/server/src/api/procedures/**"
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "ignore": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "packages/plugins/**"
    ]
  },
  "boundaries": {
    "zones": [
      { "name": "client-routes", "patterns": ["apps/client/src/routes/**"] },
      { "name": "client-app", "patterns": ["apps/client/src/app/**"] },
      {
        "name": "client-feat-connections",
        "patterns": ["apps/client/src/features/connections/**"]
      },
      {
        "name": "client-feat-settings",
        "patterns": ["apps/client/src/features/settings/**"]
      },
      {
        "name": "client-feat-admin",
        "patterns": ["apps/client/src/features/admin/**"]
      },
      {
        "name": "client-feat-admin-plugins",
        "patterns": ["apps/client/src/features/admin-plugins/**"]
      },
      {
        "name": "client-feat-admin-users",
        "patterns": ["apps/client/src/features/admin-users/**"]
      },
      {
        "name": "client-feat-admin-roles",
        "patterns": ["apps/client/src/features/admin-roles/**"]
      },
      {
        "name": "client-feat-jobs",
        "patterns": ["apps/client/src/features/jobs/**"]
      },
      {
        "name": "client-feat-home",
        "patterns": ["apps/client/src/features/home/**"]
      },
      {
        "name": "client-feat-media-detail",
        "patterns": ["apps/client/src/features/media-detail/**"]
      },
      {
        "name": "client-feat-request-flow",
        "patterns": ["apps/client/src/features/request-flow/**"]
      },
      {
        "name": "client-feat-notifications",
        "patterns": ["apps/client/src/features/notifications/**"]
      },
      {
        "name": "client-feat-watchlist",
        "patterns": ["apps/client/src/features/watchlist/**"]
      },
      {
        "name": "client-feat-diagnostics",
        "patterns": ["apps/client/src/features/diagnostics/**"]
      },
      {
        "name": "client-features-legacy",
        "patterns": ["apps/client/src/lib/**"]
      },
      { "name": "client-shared-ui", "patterns": ["apps/client/src/shared/ui/**"] },
      { "name": "client-shared-components", "patterns": ["apps/client/src/shared/components/**"] },
      { "name": "client-shared-hooks", "patterns": ["apps/client/src/shared/hooks/**"] },
      { "name": "client-shared-lib", "patterns": ["apps/client/src/shared/lib/**"] },
      { "name": "client-root", "patterns": ["apps/client/src/*.*"] },

      { "name": "server-api", "patterns": ["apps/server/src/api/**"] },
      { "name": "server-mcp", "patterns": ["apps/server/src/mcp/**"] },
      { "name": "server-jobs", "patterns": ["apps/server/src/jobs/**"] },
      {
        "name": "server-domains",
        "patterns": [
          "apps/server/src/artwork/**",
          "apps/server/src/auth/**",
          "apps/server/src/catalog/**",
          "apps/server/src/home/**",
          "apps/server/src/media/**",
          "apps/server/src/notifications/**",
          "apps/server/src/preferences/**"
        ]
      },
      {
        "name": "server-plugins",
        "patterns": ["apps/server/src/plugin-runtime/**", "apps/server/src/plugins/**"]
      },
      {
        "name": "server-infra",
        "patterns": [
          "apps/server/src/db/**",
          "apps/server/src/cache/**",
          "apps/server/src/crypto/**",
          "apps/server/src/connections/**",
          "apps/server/src/diagnostics/**"
        ]
      },
      { "name": "server-root", "patterns": ["apps/server/src/*.*"] },

      { "name": "plugins", "patterns": ["packages/plugins/**"] },
      { "name": "plugin-sdk", "patterns": ["packages/plugin-sdk/**"] },
      { "name": "shared-pkg", "patterns": ["packages/shared/**"] }
    ],
    "rules": [
      {
        "from": "client-root",
        "allow": [
          "client-routes",
          "client-app",
          "client-feat-connections",
          "client-feat-settings",
          "client-feat-admin",
          "client-feat-admin-users",
          "client-feat-admin-roles",
          "client-feat-jobs",
          "client-feat-home",
          "client-feat-watchlist",
          "client-feat-notifications",
          "client-features-legacy",
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-routes",
        "allow": [
          "client-app",
          "client-feat-connections",
          "client-feat-settings",
          "client-feat-admin",
          "client-feat-admin-users",
          "client-feat-admin-roles",
          "client-feat-jobs",
          "client-feat-home",
          "client-feat-watchlist",
          "client-feat-media-detail",
          "client-feat-request-flow",
          "client-feat-notifications",
          "client-feat-diagnostics",
          "client-feat-admin-plugins",
          "client-features-legacy",
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-feat-admin-plugins",
        "allow": [
          "client-feat-admin",
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-feat-diagnostics",
        "allow": [
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-feat-watchlist",
        "allow": [
          "client-feat-home",
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-feat-notifications",
        "allow": [
          "client-feat-connections",
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-feat-connections",
        "allow": [
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-feat-settings",
        "allow": [
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-feat-admin",
        "allow": [
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-feat-admin-users",
        "allow": [
          "client-app",
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-feat-admin-roles",
        "allow": [
          "client-app",
          "client-feat-admin-users",
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-feat-jobs",
        "allow": [
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-app",
        "allow": [
          "client-feat-notifications",
          "client-feat-settings",
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-features-legacy",
        "allow": [
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-shared-components",
        "allow": [
          "client-feat-request-flow",
          "client-shared-ui",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      { "from": "client-shared-hooks", "allow": ["client-shared-lib", "shared-pkg"] },
      { "from": "client-shared-ui", "allow": ["client-shared-lib", "shared-pkg"] },
      {
        "from": "client-feat-home",
        "allow": [
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-feat-media-detail",
        "allow": [
          "client-feat-home",
          "client-feat-request-flow",
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      {
        "from": "client-feat-request-flow",
        "allow": [
          "client-shared-ui",
          "client-shared-components",
          "client-shared-hooks",
          "client-shared-lib",
          "shared-pkg"
        ]
      },
      { "from": "client-shared-lib", "allow": ["shared-pkg", "server-api", "server-root"] },

      {
        "from": "server-root",
        "allow": [
          "server-api",
          "server-mcp",
          "server-jobs",
          "server-domains",
          "server-plugins",
          "server-infra",
          "shared-pkg",
          "plugin-sdk",
          "plugins"
        ]
      },
      {
        "from": "server-api",
        "allow": [
          "server-root",
          "server-domains",
          "server-plugins",
          "server-infra",
          "server-mcp",
          "server-jobs",
          "shared-pkg",
          "plugin-sdk"
        ]
      },
      {
        "from": "server-mcp",
        "allow": [
          "server-root",
          "server-domains",
          "server-infra",
          "shared-pkg",
          "server-plugins",
          "plugin-sdk",
          "server-jobs"
        ]
      },
      {
        "from": "server-jobs",
        "allow": [
          "server-root",
          "server-domains",
          "server-plugins",
          "server-infra",
          "shared-pkg",
          "plugin-sdk"
        ]
      },
      {
        "from": "server-domains",
        "allow": [
          "server-root",
          "server-jobs",
          "server-mcp",
          "server-infra",
          "shared-pkg",
          "plugin-sdk",
          "server-plugins"
        ]
      },
      {
        "from": "server-plugins",
        "allow": [
          "server-root",
          "server-domains",
          "server-infra",
          "shared-pkg",
          "plugin-sdk",
          "plugins"
        ]
      },
      {
        "from": "server-infra",
        "allow": ["server-root", "shared-pkg", "server-plugins", "plugin-sdk", "server-domains"]
      },

      { "from": "plugins", "allow": ["plugin-sdk", "shared-pkg"] },
      { "from": "plugin-sdk", "allow": ["shared-pkg"] },
      { "from": "shared-pkg", "allow": [] }
    ]
  }
}
