    "unused-exports": "error",
    "unused-types": "warn",
    "unused-deps": "warn",
    "circular-deps": "error",
    "duplicate-exports": "warn"
  },
  "duplicates": {
    "mode": "semantic",
    "minTokens": 50,
    "minLines": 5,
    "ignoreImports": true,
