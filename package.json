{
  "name": "ent-mcp",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "trap 'kill 0' SIGINT; bun run dev:server & bun run dev:client; wait",
    "dev:server": "bun --env-file=$(pwd)/.env --cwd packages/server --hot src/index.ts",
    "dev:client": "bun run --cwd packages/client dev",
    "build:client": "bun run --cwd packages/client build",
    "typecheck": "bun run --cwd packages/shared tsc --noEmit && bun run --cwd packages/server tsc --noEmit && bun run --cwd packages/client tsc --noEmit",
    "inspect": "bun x @modelcontextprotocol/inspector ",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "vite-plus": "^0.1.18"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.12",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "latest",
    "@better-auth/oauth-provider": "^1.6.5",
    "better-auth": "^1.6.5",
    "hono": "^4.12.14",
    "typescript": "^6.0.0",
    "zod": "^4.3.6"
  }
}
