{
  "name": "ent-mcp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "dev": "trap 'kill 0' SIGINT; bun run dev:server & bun run dev:client; wait",
    "dev:server": "bun --env-file=$(pwd)/.env --cwd apps/server --hot src/index.ts",
    "dev:client": "bun run --cwd apps/client dev",
    "build:client": "bun run --cwd apps/client build",
    "db:migrate": "bun run apps/server/src/db/migrate.ts",
    "db:create-user": "bun run apps/server/src/db/create-user.ts",
    "check:file-sizes": "bun run tools/check-file-sizes.ts",
    "typecheck": "bun run --cwd packages/shared tsc --noEmit && bun run --cwd apps/server tsc --noEmit && bun run --cwd apps/client tsc --noEmit",
    "inspect": "bun x @modelcontextprotocol/inspector ",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "fallow": "^2.85.0",
    "react-doctor": "^0.2.14",
    "vite-plus": "^0.1.23",
    "wrangler": "^4.95.0"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.12",
  "catalog": {
    "es-toolkit": "^1.47.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "latest",
    "@better-auth/oauth-provider": "^1.6.12",
    "better-auth": "^1.6.12",
    "hono": "^4.12.23",
    "jszip": "^3.10.1",
    "typescript": "^6.0.3",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3"
  }
}
