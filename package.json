{
  "name": "ent-mcp",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "trap 'kill 0' SIGINT; bun run dev:server & bun run dev:client; wait",
    "dev:server": "bun --env-file=$(pwd)/.env --cwd packages/server --watch src/index.ts",
    "dev:client": "bun run --cwd packages/client dev",
    "build:client": "bun run --cwd packages/client build",
    "typecheck": "bun run --cwd packages/server tsc --noEmit && bun run --cwd packages/client tsc --noEmit",
    "inspect": "bunx @modelcontextprotocol/inspector bun --cwd packages/server --env-file=$(pwd)/.env src/mcp/stdio.ts",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.12",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "latest"
  }
}
